amp_variant_note() {
    cat <<'NOTE'

    note: this package ships the tree's snd-soc-wsa881x.ko (the "gain" build).
          Installing it overwrites any amplifier variant selected with
          install-amp-variant.sh, and that difference is audible
          (pops / an amplifier left powered with no stream).  Re-apply the
          variant you want now:
              sudo audio-fix-install.sh         # stock driver
              sudo install-amp-variant.sh h1a   # never power-cycle
NOTE
}

post_install() {
    amp_variant_note
}

post_upgrade() {
    if findmnt --fstab -uno SOURCE /boot &>/dev/null && ! mountpoint -q /boot; then
        echo "WARNING: /boot appears to be a separate partition but is not mounted."
    fi
    amp_variant_note
}

post_remove() {
    # The package's name, not the upstream linux-surface one: the preset builds
    # /boot/initramfs-linux-mibook.img.  It declares a 'fallback' preset but
    # leaves fallback_image unset, so mkinitcpio skips it ("No image or UKI
    # specified") and only the default image exists today; remove both names so
    # a future fallback image is cleaned up too.
    rm -f boot/initramfs-linux-mibook.img
    rm -f boot/initramfs-linux-mibook-fallback.img
}

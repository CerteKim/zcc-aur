+
+/*
+ * The Windows panel XML (PNC357DB1.xml) says the backlight is PMIC-side, and
+ * that is right - but it is the LPG PWM, not the WLED.  This WLED block reads
+ * back as all zeroes, disabling its module does not turn the panel off, and no
+ * register in it changes with the backlight value, so it is not wired to the
+ * panel's LEDs on this board.  Keep it disabled: it only registers a second,
+ * useless "backlight" device that competes with the pwm-backlight one.
+ */
+&pmc8180c_wled {
+	status = "disabled";
+};

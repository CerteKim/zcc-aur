+/*
+ * Enable the PM8150 PON power key.  sc8180x-pmics.dtsi declares the node but
+ * leaves it disabled, and upstream enables it per board (3706bcfbdb8a,
+ * "arm64: dts: qcom: sc8180x: Enable the power key" - done for Primus and the
+ * Lenovo Flex 5G).  Without it there is no KEY_POWER input device at all, and
+ * since pm8941-pwrkey registers as a wakeup source by default
+ * (wakeup_source_default = true) there is also no way to wake the machine with
+ * the power button - which is what a suspend hang looks like from the outside.
+ */
+&pmc8180_pwrkey {
+	status = "okay";
+};
+
+/*
+ * Volume down is the PON's RESIN line, not a PMIC GPIO (ACPI pin 0x0001 on
+ * PM01, next to the power key at 0x0000).  sc8180x-pmics.dtsi declares it
+ * disabled, as upstream does for the PMIC nodes; the same enable exists on the
+ * Surface Duo (sm8150-microsoft-surface-duo.dts) for exactly this key.
+ */
+&pmc8180_resin {
+	status = "okay";
+	linux,code = <KEY_VOLUMEDOWN>;
+};
+
+/*
+ * Volume up is a PMIC GPIO.  Both readings below are declared for now, both as
+ * inputs with an internal pull-up - matching the Surface Pro X port, which
+ * drives its volume keys active-low with a pull-up.  If a key reports the
+ * opposite of what is pressed, the flag (or the bias) is what needs flipping.
+ */
+&pmc8180_1_gpios {
+	volume_up_6_default_state: volume-up-6-default-state {
+		pins = "gpio6";
+		function = "normal";
+		input-enable;
+		bias-pull-up;
+		qcom,drive-strength = <0>;
+	};
+
+	volume_up_5_default_state: volume-up-5-default-state {
+		pins = "gpio5";
+		function = "normal";
+		input-enable;
+		bias-pull-up;
+		qcom,drive-strength = <0>;
+	};
+};

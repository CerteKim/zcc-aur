+/*
+ * Windows exposes the touchscreen bus as \_SB.I2C2, but its MMIO base is
+ * 0x00884000, which maps to Linux's &i2c1 / QUP0 SE1.
+ */
+&i2c1 {
+	clock-frequency = <400000>;
+
+	pinctrl-0 = <&i2c1_active>;
+	pinctrl-names = "default";
+
+	status = "okay";
+
+	touchscreen@4f {
+		compatible = "hid-over-i2c";
+		reg = <0x4f>;
+
+		hid-descr-addr = <0x1>;
+		vdd-supply = <&vreg_l4c_3p3>;
+		vddl-supply = <&vreg_l12e_1p8>;
+		post-power-on-delay-ms = <200>;
+
+		interrupts-extended = <&tlmm 122 IRQ_TYPE_LEVEL_LOW>;
+
+		pinctrl-0 = <&ts_irq_active>;
+		pinctrl-names = "default";
+	};
+};
+
+&i2c7 {
+	/*
+	 * The platform firmware declares 400 kHz for this bus (the ACPI
+	 * descriptor uses 0x00061A80).  1 MHz makes it marginal: broad
+	 * i2cdetect sweeps on the charger below produce "Bus arbitration
+	 * lost, clock line undriveable".
+	 */
+	clock-frequency = <400000>;
+
+	pinctrl-0 = <&i2c7_active>;
+	pinctrl-names = "default";
+
+	status = "okay";
+
+	/*
+	 * Renesas RA9530 stylus charger (ACPI Device (SXB), _HID "TXRA9530").
+	 *
+	 * No pinctrl-0 is needed: the firmware already leaves all five pins
+	 * muxed as plain GPIOs with the right bias and drive settings, and the
+	 * driver takes them over through gpiod.
+	 */
+	pen_charger: charger@3b {
+		compatible = "renesas,ra9530";
+		reg = <0x3b>;
+
+		/* external switch and 7 V boost; firmware leaves both on */
+		switch-gpios = <&tlmm 11 GPIO_ACTIVE_HIGH>;
+		boost-gpios = <&tlmm 186 GPIO_ACTIVE_HIGH>;
+
+		/*
+		 * Two hall sensors; the stylus is attached while they differ.
+		 * Measured on this board: gpio97 is low with the pen attached,
+		 * gpio189 stays high.
+		 */
+		pen-detect-gpios = <&tlmm 97 GPIO_ACTIVE_LOW>,
+				   <&tlmm 189 GPIO_ACTIVE_LOW>;
+
+		/* chip interrupt, open drain, active low */
+		interrupt-parent = <&tlmm>;
+		interrupts = <101 IRQ_TYPE_EDGE_FALLING>;
+
+		renesas,fod-mw = <500>;
+	};
+};

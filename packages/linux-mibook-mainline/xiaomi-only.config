CONFIG_DRM_PANEL_EDP=y
CONFIG_DRM_PANEL_BOE_TV101WUM_NL6=y
# =m on purpose: the panel driver is one of the files still being iterated on
# (DSC, timing), and zcc-aur ships it as a DKMS package whose copy in
# /lib/modules/$ver/updates/dkms/ overrides this one.  With =y the built-in
# driver claims the panel at boot and the DKMS module is never used.
CONFIG_DRM_PANEL_HIMAX_HX83121A=m

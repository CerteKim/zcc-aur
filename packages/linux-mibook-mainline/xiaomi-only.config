CONFIG_MMC_SDHCI_TEGRA=n
CONFIG_MMC_TOSHIBA_PCI=n
CONFIG_DEBUG_INFO=y
# CONFIG_DEBUG_INFO_REDUCED is not set
CONFIG_DEBUG_INFO_BTF=y
CONFIG_KPROBE_EVENTS=y
CONFIG_DEBUG_INFO_BTF=y
CONFIG_NETKIT=y
CONFIG_INET_DIAG=y
CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT=y

# Video decode: the SC8180X block is IRIS1 (Windows firmware VIDEO.IR.1.2),
# handled by the iris driver.  iris only compiles its IRIS1 platform data when
# the venus driver is not selected, and no sc8180x board needs venus.
CONFIG_VIDEO_QCOM_IRIS=m
# CONFIG_VIDEO_QCOM_VENUS is not set

CONFIG_UCLAMP_TASK=y
CONFIG_UCLAMP_TASK_GROUP=y

CONFIG_WQ_POWER_EFFICIENT_DEFAULT=y
CONFIG_SCHED_CLASS_EXT=y

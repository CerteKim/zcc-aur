##
## Xiaomi Book S 12.4 / SC8180X device-tree-only fragment.
##
## This replaces surface.config + overrides.config + xiaomi.config.  It keeps
## the hardware that is either known to be present or useful for bring-up
## (USB storage/network/HID, sensors, camera/media core), and removes drivers
## for unrelated SoC families and Surface-specific devices.
##

##
## Default command line / early console.
##
CONFIG_CMDLINE="clk_ignore_unused"
CONFIG_CMDLINE_FROM_BOOTLOADER=y
CONFIG_CMDLINE_FORCE=n

##
## Use FB_SIMPLE over DRM_SIMPLE.
##
CONFIG_DRM_SIMPLEDRM=n
CONFIG_FB_SIMPLE=y

##
## Build/debug policy.
##
CONFIG_DEBUG_INFO_NONE=n
CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT=y
CONFIG_DEBUG_INFO_DWARF4=y
CONFIG_DEBUG_INFO_DWARF5=y
CONFIG_LOCALVERSION=""
CONFIG_LOCALVERSION_AUTO=n
CONFIG_RCU_CPU_STALL_TIMEOUT=10
CONFIG_RCU_EXP_CPU_STALL_TIMEOUT=250

##
## Architecture: this package is only for the Xiaomi SC8180X platform.
##
CONFIG_ARCH_QCOM=y
CONFIG_ARCH_SUNXI=n
CONFIG_ARCH_APPLE=n
CONFIG_ARCH_BCM=n
CONFIG_ARCH_BCM2835=n
CONFIG_ARCH_BCMBCA=n
CONFIG_ARCH_HISI=n
CONFIG_ARCH_MEDIATEK=n
CONFIG_ARCH_MESON=n
CONFIG_ARCH_MVEBU=n
CONFIG_ARCH_NXP=n
CONFIG_ARCH_LAYERSCAPE=n
CONFIG_ARCH_MXC=n
CONFIG_ARCH_ROCKCHIP=n
CONFIG_ARCH_SEATTLE=n
CONFIG_ARCH_TEGRA=n
CONFIG_ARCH_VEXPRESS=n
CONFIG_ARCH_XGENE=n
CONFIG_SOC_IMX8M=n
CONFIG_SOC_IMX9=n

##
## Core Qualcomm platform support.
##
CONFIG_IOMMU_SUPPORT=y
CONFIG_ARM_SMMU=y
CONFIG_ARM_SMMU_QCOM=y
CONFIG_QCOM_IOMMU=y
CONFIG_QCOM_PDC=y
CONFIG_ARM_QCOM_CPUFREQ_HW=y
CONFIG_HWSPINLOCK=y
CONFIG_HWSPINLOCK_QCOM=y
CONFIG_MAILBOX=y

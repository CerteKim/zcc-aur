From 0a1b27b49b8f26d89dd3841560d49b1e9e32d85e Mon Sep 17 00:00:00 2001
From: Certe Kim <18364439+CerteKim@users.noreply.github.com>
Date: Wed, 7 Oct 2026 22:30:07 +0800
Subject: [PATCH] tools/lib/bpf: cast string-search results

strstr() and strchr() return a const char * when given a const string,
but the call sites assign to char *.  Cast the results to keep the
builders quiet with newer toolchains; upstream 7.2 still needs this.
---
 tools/lib/bpf/libbpf.c | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/tools/lib/bpf/libbpf.c b/tools/lib/bpf/libbpf.c
index 1368752aa13c..e538b3b5fa2c 100644
--- a/tools/lib/bpf/libbpf.c
+++ b/tools/lib/bpf/libbpf.c
@@ -8637,7 +8637,7 @@ static int kallsyms_cb(unsigned long long sym_addr, char sym_type,
 	struct extern_desc *ext;
 	const char *res;
 
-	res = strstr(sym_name, ".llvm.");
+	res = (char *)strstr(sym_name, ".llvm.");
 	if (sym_type == 'd' && res)
 		ext = find_extern_by_name_with_len(obj, sym_name, res - sym_name);
 	else
@@ -12115,7 +12115,7 @@ static int avail_kallsyms_cb(unsigned long long sym_addr, char sym_type,
 		char sym_trim[256], *psym_trim = sym_trim;
 		const char *sym_sfx;
 
-		if (!(sym_sfx = strstr(sym_name, ".llvm.")))
+		if (!(sym_sfx = (char *)strstr(sym_name, ".llvm.")))
 			return 0;
 
 		/* psym_trim vs sym_trim dance is done to avoid pointer vs array
@@ -12998,7 +12998,7 @@ static int resolve_full_path(const char *file, char *result, size_t result_sz)
 
 			if (s[0] == ':')
 				s++;
-			next_path = strchr(s, ':');
+			next_path = (char *)strchr(s, ':');
 			seg_len = next_path ? next_path - s : strlen(s);
 			if (!seg_len)
 				continue;

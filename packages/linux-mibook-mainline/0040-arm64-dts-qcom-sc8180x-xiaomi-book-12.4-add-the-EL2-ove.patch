 dtb-$(CONFIG_ARCH_QCOM)	+= sc8180x-lenovo-flex-5g.dtb
 dtb-$(CONFIG_ARCH_QCOM)	+= sc8180x-primus.dtb
-dtb-$(CONFIG_ARCH_QCOM)	+= sc8180x-xiaomi-book-12.4.dtb
+sc8180x-xiaomi-book-12.4-el2-dtbs := sc8180x-xiaomi-book-12.4.dtb sc8180x-el2.dtbo
+dtb-$(CONFIG_ARCH_QCOM)	+= sc8180x-xiaomi-book-12.4.dtb sc8180x-xiaomi-book-12.4-el2.dtb

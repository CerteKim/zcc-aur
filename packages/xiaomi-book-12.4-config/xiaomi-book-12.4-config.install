post_install() {
    echo "==> 让 systemd 与 udev 看到新单元/规则"
    systemctl daemon-reload || true
    udevadm control --reload 2>/dev/null || true

    echo
    echo "==> WCN3998 蓝牙地址（默认 02:00:00:12:34:56，可改 /etc/conf.d/bluetooth-bdaddr）"
    echo "    启用： sudo systemctl enable --now bluetooth-bdaddr.service"

    echo
    echo "==> GRUB 设备树菜单项已安装（/etc/grub.d/09_xiaomi_book_dtb）"
    echo "    ALARM 的 grub 不会生成 devicetree 行，本机固件又不提供 DTB，"
    echo "    所以必须让引导配置带上它。生效方式："
    echo "        sudo grub-mkconfig -o /boot/grub/grub.cfg"
    echo "    建议同时停用会自动生成【无 DTB】菜单项的 10_linux："
    echo "        sudo chmod -x /etc/grub.d/10_linux"

    echo
    echo "==> RA9530 笔策略守护（充电阈值 + 停靠时屏蔽笔输入）"
    if [ -e /etc/systemd/system/ra9530-charge-policy.service ]; then
        echo "    !! /etc/systemd/system/ra9530-charge-policy.service 还在（手工时代的那份）"
        echo "       /etc 会盖住本包装到 /usr/lib/systemd/system/ 的同名单元。请先："
        echo "           sudo systemctl disable --now ra9530-charge-policy.service"
        echo "           sudo rm /etc/systemd/system/ra9530-charge-policy.service"
        echo "           sudo systemctl daemon-reload"
    fi
    echo "    启用： sudo systemctl enable --now ra9530-charge-policy.service"
    echo "    看状态： journalctl -u ra9530-charge-policy -f"
    echo "    （工具原先由上游 ra9530-mainline 的 install.sh 手工装；现在归本包，"
    echo "      文件路径没变，仍是 /usr/local/bin/ra9530-*.sh）"
}

post_upgrade() {
    post_install
}

# Maintainer: Certe Kim <18364439+CerteKim@users.noreply.github.com>
#
# Machine-specific configuration for the Xiaomi Book S 12.4 (sc8180x / TIMI):
#   * ALSA UCM profile for the WCD9340 + WSA881x speaker setup
#   * WCN3998 Bluetooth address workaround (unit + udev rule + conf)
#
# It used to carry prebuilt panel device trees as well.  Those were snapshots
# from the bring-up (before the power key, before the GPU OV states) and are
# superseded: the panel link mode they encoded is what the kernel source builds
# anyway, and the power key is described in the DTS.  They stay in the working
# tree because tools/set-panel-link-mode.sh reads them from there, but they are
# not shippable artifacts.
#
# Firmware lives in "xiaomi-book-12.4-firmware", the kernel in "linux-mibook"
# and the stylus charger driver in "ra9530-dkms".

pkgname=xiaomi-book-12.4-config
pkgver=1
pkgrel=2
pkgdesc="Xiaomi Book S 12.4 (sc8180x): ALSA UCM profile and Bluetooth address fix"
arch=('any')
url="https://github.com/CerteKim/zcc-aur"
license=('custom')
depends=('alsa-ucm-conf')
optdepends=('bluez-utils: bluetooth-bdaddr.service needs btmgmt and hciconfig')
backup=('etc/conf.d/bluetooth-bdaddr')
install=$pkgname.install
source=(
    '60-bluetooth-bdaddr.rules'
    'bluetooth-bdaddr.conf'
    'bluetooth-bdaddr.service'
    'bluetooth-bdaddr.sh'
    'ucm-HiFi.conf'
    'ucm-TIMI-XiaomiBook12.4-INVALID-TM2133.conf'
)
sha256sums=(
    '3856760ba63f0606ccb11f58e19118ac699514bd78ed6fca18e7f848206f104f'
    '51f3ed8a757e5653c186dc26c44b0a96cc327918561f3e51db87af98d074ac7d'
    'd1c942bb46110fb92a13b90aa067d0162c869328e97abdcfb6f42dad73ae0349'
    'e594356e6d37fca26b859306425264d57ad2c104a31db3fb5d19581c771de762'
    '03c58f8e9b3e0b1536cad33c1972b63de46efbb757333c97bd7cce363746f00e'
    '4eef301b0ef2e38b7a35bb12115b5886a3a40badb5d10043b52709a6e9755a50'
)

package() {
    # ALSA UCM
    install -Dm644 ucm-HiFi.conf "$pkgdir/usr/share/alsa/ucm2/Qualcomm/xiaomi-book-12.4/HiFi.conf"
    install -Dm644 ucm-TIMI-XiaomiBook12.4-INVALID-TM2133.conf \
        "$pkgdir/usr/share/alsa/ucm2/conf.d/sdm845/TIMI-XiaomiBook12.4-INVALID-TM2133.conf"

    # WCN3998 Bluetooth address — the unit runs /usr/local/bin/bluetooth-bdaddr.sh
    # and the script sources /etc/conf.d/bluetooth-bdaddr, so keep those paths.
    install -Dm755 bluetooth-bdaddr.sh      "$pkgdir/usr/local/bin/bluetooth-bdaddr.sh"
    install -Dm644 bluetooth-bdaddr.conf    "$pkgdir/etc/conf.d/bluetooth-bdaddr"
    install -Dm644 bluetooth-bdaddr.service "$pkgdir/usr/lib/systemd/system/bluetooth-bdaddr.service"
    install -Dm644 60-bluetooth-bdaddr.rules "$pkgdir/usr/lib/udev/rules.d/60-bluetooth-bdaddr.rules"
}

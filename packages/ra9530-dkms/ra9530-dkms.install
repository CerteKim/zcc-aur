MODNAME=ra9530
# 兜底版本号：正常情况下从 pacman 传给脚本函数的参数里取（见下），
# 这里只是以防万一。改版本时 dkms.conf / PKGBUILD / 这一行三处保持一致。
FALLBACK_VER=1.0.4

purge_stale() {
    # 之前用普通 modules_install 装过的副本（extra/ 或 updates/）优先级可能高于
    # DKMS 的 updates/dkms/，残留会让 modprobe 一直加载旧模块 —— 这里先清掉。
    local f
    while IFS= read -r f; do
        case "$f" in
            */updates/dkms/*) ;;
            *)
                echo "    移除旧的模块副本: $f"
                rm -f "$f"
                ;;
        esac
    done < <(find "/lib/modules/$(uname -r)" -name 'ra9530-charger.ko*' 2>/dev/null)
}

# pacman 传进来的是「完整版本串」pkgver-pkgrel，不是包名（PKGBUILD(5)：
# post_install 一个参数 $1=1.0.4-1；post_upgrade 两个参数 $1=1.0.4-1
# $2=1.0.3-2；pre_remove 一个参数 $1=1.0.4-1）。DKMS 要的是 dkms.conf 里的
# PACKAGE_VERSION，不带 pkgrel，所以末尾的 -pkgrel 要砍掉。
# （早先这里按 $2 取版本，实际拿到的是旧版本串，1.0.1 那次就是这么撞上的。）
dkms_version() {
    # 1.0.4-1 -> 1.0.4（没有 -pkgrel 时原样返回）
    echo "${1%-*}"
}

post_install() {
    local MODVER
    MODVER=$(dkms_version "${1:-$FALLBACK_VER}")

    echo "==> 为内核 $(uname -r) 构建并安装 $MODNAME/$MODVER"
    purge_stale
    if dkms install -m "$MODNAME" -v "$MODVER" --force; then
        echo "    完成。检查：dmesg | grep -i ra9530"
    else
        echo "!! DKMS 构建失败。最常见的原因是缺少当前内核的构建目录："
        echo "     /lib/modules/$(uname -r)/build"
        echo "   装好对应内核（例如 linux-mibook）后手动重试："
        echo "     sudo dkms install -m $MODNAME -v $MODVER --force"
    fi

    echo
    echo "==> 驱动需要设备树里有 charger@3b 节点，本仓库的内核包自带："
    if [ -d /proc/device-tree/soc@0/geniqup@8c0000/i2c@89c000/charger@3b ]; then
        echo "    ✓ 已存在"
    else
        echo "    ✗ 不存在 —— 当前内核的 DTB 不是由本仓库的 linux-mibook 构建的。"
        echo "      请改用该内核包（其源码已描述该节点），见 github.com/CerteKim/zcc-aur"
    fi

    echo
    echo "==> 充电策略与停靠闸门（由 xiaomi-book-12.4-config 提供，需要笔已配对）"
    echo "    驱动在 /sys/bus/i2c/devices/1-003b/ 下提供 enabled 开关，以及 pen_present"
    echo "    状态（跳变时 sysfs_notify()，守护进程阻塞等它而不是每秒轮询）。"
    echo "    守护进程、BLE 电量脚本、systemd 单元和等待器都在那个包里，装它即可："
    echo "        sudo pacman -S xiaomi-book-12.4-config"
}

post_upgrade() {
    post_install "$@"
}

pre_upgrade() {
    # 升级前先摘掉旧版本的 DKMS 登记：它指向的 /usr/src/ra9530-<旧版本>
    # 紧接着就会被 pacman 删掉，留着会变成悬空条目 —— 以后每次装内核，
    # DKMS 的 alpm hook 都会拿它去构建并失败。
    [[ -n ${2:-} ]] || return 0
    local OLDVER
    OLDVER=$(dkms_version "$2")
    echo "==> 移除旧版 DKMS 登记 $MODNAME/$OLDVER"
    dkms remove -m "$MODNAME" -v "$OLDVER" --all >/dev/null 2>&1 || true
}

pre_remove() {
    local MODVER
    MODVER=$(dkms_version "${1:-$FALLBACK_VER}")
    echo "==> 移除 DKMS 模块 $MODNAME/$MODVER"
    dkms remove -m "$MODNAME" -v "$MODVER" --all || true
}
